# Copy this file to .env and adjust as needed. .env itself is git-ignored —
# never commit real secrets, even local-dev-only ones, to this repo (it is
# published for portfolio review; see PORTFOLIO.md).

# --- dice-postgres ---
# POSTGRES_USER is a superuser for local dev/migrations only. Each service
# connects with its own least-privilege role instead (created by
# infra/postgres/init/001_schemas_and_roles.sql) — see the architecture doc, §9/§13.a.
POSTGRES_USER=dice_admin
POSTGRES_PASSWORD=dice_admin_dev_pw
POSTGRES_DB=dice_job_manager
POSTGRES_HOST_PORT=55432

# --- dice-ollama ---
# Local model only — no cloud LLM API is used anywhere in this project (§13.o).
OLLAMA_HOST_PORT=4110
OLLAMA_MODEL=llama3.1:8b

# --- JWT (from Phase 2 onward) ---
# RS256 key pair: user-service holds the private key and signs; job-service,
# stock-service, and mcp-server hold only the public key and verify (§11).
# Generate locally in Phase 2 — never commit the private key.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
